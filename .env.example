# ==============================================================================
# .ENV.EXAMPLE - DANH SÁCH BIẾN MÔI TRƯỜNG MẪU (KHÔNG CHỨA MẬT KHẨU THẬT)
# Sao chép tệp này thành .env và cập nhật giá trị thực tế trên máy cá nhân.
# ==============================================================================

# 1. Cấu hình Cổng Server Backend (Spring Boot)
SERVER_PORT=8080

# 2. Cấu hình Cơ sở dữ liệu MySQL 8.0
DB_HOST=localhost
DB_PORT=3306
DB_NAME=parttime_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_root_password_here

# 3. Cấu hình Bảo mật JWT (HMAC-SHA256 yêu cầu khóa bí mật tối thiểu 32 ký tự / 256-bit)
JWT_SECRET=replace-with-at-least-32-character-secret-key-for-hmac-sha256
JWT_EXPIRATION_SECONDS=7200

# 4. Cấu hình Frontend (ReactJS + Vite)
VITE_API_BASE_URL=http://localhost:8080/api/v1
