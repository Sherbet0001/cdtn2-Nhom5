        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Lê Hoàng Nam\",\n  \"phone\": \"0914333444\",\n  \"locationId\": 5,\n  \"bio\": \"Sinh viên năm 3 ngành Công nghệ phần mềm\",\n  \"school\": \"Đại học Văn Lang\",\n  \"major\": \"Công nghệ phần mềm\",\n  \"cvContent\": \"Kỹ năng: Java, Spring Boot, ReactJS, MySQL. Rảnh các ca tối trong tuần.\"\n}"
