            "key": "Authorization",
            "value": "Bearer {{jwtToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/profiles/me",
          "host": ["{{baseUrl}}"],
          "path": ["profiles", "me"]
        }
      }
    },
    {
