  "item": [
    {
      "name": "1. POST /auth/register - Đăng ký Sinh viên (FR-01)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Trần Minh Khoa\",\n  \"email\": \"sv.moi@vanlanguni.vn\",\n  \"password\": \"Abc@12345\",\n  \"role\": \"STUDENT\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "2. POST /auth/login - Đăng nhập nhận JWT 2h (FR-02)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sv1@vanlanguni.vn\",\n  \"password\": \"Abc@12345\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "3. GET /profiles/me - Xem hồ sơ cá nhân hiện tại (FR-05)",
