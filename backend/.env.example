# ==============================================================================
# .ENV.EXAMPLE - DANH SÁCH BIẾN MÔI TRƯỜNG MẪU CHO BACKEND (SPRING BOOT)
# Sao chép tệp này thành .env và cập nhật giá trị thực tế trên máy cá nhân.
# ==============================================================================

SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=3306
DB_NAME=parttime_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_root_password_here
JWT_SECRET=replace-with-at-least-32-character-secret-key-for-hmac-sha256
JWT_EXPIRATION_SECONDS=7200

